# Google OAuth Configuration
# Get your Google Client ID from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend API URL
# Optional: set this if you want the frontend to call the backend directly instead of using the Netlify proxy.
# For Vercel frontend deployments, set this to your deployed backend URL.
VITE_API_URL=
